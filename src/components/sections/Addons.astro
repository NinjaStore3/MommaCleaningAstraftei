---
import { addons, euro } from '../../lib/pricing';
---

<section class="section" id="prostheta" aria-labelledby="addons-title">
  <div class="wrap addons">
    <div class="section-head">
      <p class="eyebrow">Πρόσθετα</p>
      <h2 id="addons-title">Πρόσθετες εργασίες</h2>
      <p>Προστίθενται σε οποιονδήποτε καθαρισμό. Ενημερώστε με από πριν, για να υπολογίσω τον χρόνο.</p>
    </div>
    <ul class="menu" role="list">
      {
        addons.map((a) => (
          <li class="menu__item">
            <span class="menu__name">
              {a.name}
              {a.note && <span class="menu__note">{a.note}</span>}
            </span>
            <span class="menu__dots" aria-hidden="true" />
            <span class="price menu__price">
              {euro(a.price)}
              {a.perHour && <span class="menu__unit">/ώρα</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .addons {
    display: grid;
    gap: 1rem;
  }
  .menu {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    column-gap: 4rem;
  }
  /* Taverna-menu style: name ........ price */
  .menu__item {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 0.6rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .menu__name {
    font-weight: 500;
  }
  .menu__note {
    display: block;
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--ink-soft);
  }
  .menu__dots {
    border-bottom: 2px dotted var(--line);
    transform: translateY(-0.3em);
    min-width: 1rem;
  }
  .menu__price {
    font-size: 1.375rem;
    white-space: nowrap;
  }
  .menu__unit {
    font-size: 0.9375rem;
    font-family: var(--sans);
    font-weight: 500;
    color: var(--ink-soft);
    margin-left: 0.15rem;
  }

  @media (min-width: 900px) {
    .addons {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
      align-items: start;
    }
    .addons .section-head {
      margin-bottom: 0;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }
  @media (min-width: 1100px) {
    .menu {
      grid-template-columns: 1fr 1fr;
      column-gap: 2.5rem;
    }
  }
</style>
