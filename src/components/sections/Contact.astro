---
import Icon from '../ui/Icon.astro';
import { site, links, hasEmail } from '../../lib/site';
import { services } from '../../lib/pricing';

const serviceOptions = (['standard', 'deep', 'move', 'airbnb', 'renovation'] as const).map((id) => ({
  id,
  name: services[id].name,
}));
const allAreas = site.areas.groups.flatMap((g) => g.items);
---

<section class="section section--sand" id="epikoinonia" aria-labelledby="contact-title">
  <div class="wrap contact">
    <div class="contact__intro">
      <p class="eyebrow">Ραντεβού</p>
      <h2 id="contact-title">Κλείστε ραντεβού</h2>
      <p class="lead">
        Τηλεφωνήστε μου ή συμπληρώστε τη φόρμα και στείλτε τη με WhatsApp, Viber ή email. Αν δεν απαντήσω, βρίσκομαι σε
        δουλειά και θα σας καλέσω μόλις τελειώσω.
      </p>

      <div class="direct">
        <a class="direct__item" href={links.tel}>
          <Icon name="phone" />
          <span><span class="direct__label">Τηλέφωνο</span>{site.contact.phoneDisplay}</span>
        </a>
        {
          site.contact.viber && (
            <a class="direct__item" href={links.viber()}>
              <Icon name="viber" />
              <span>
                <span class="direct__label">Viber</span>Στείλτε μήνυμα
              </span>
            </a>
          )
        }
        {
          site.contact.whatsapp && (
            <a class="direct__item" href={links.whatsapp()} target="_blank" rel="noopener">
              <Icon name="whatsapp" />
              <span>
                <span class="direct__label">WhatsApp</span>Στείλτε μήνυμα
              </span>
            </a>
          )
        }
        {
          hasEmail && (
            <a class="direct__item" href={links.mail()}>
              <Icon name="mail" />
              <span>
                <span class="direct__label">Email</span>
                {site.contact.email}
              </span>
            </a>
          )
        }
      </div>
      <p class="contact__hours"><Icon name="clock" /> {site.contact.hours}</p>
    </div>

    <!-- No server: the form builds a message and opens WhatsApp, Viber or email with it filled in. -->
    <form
      class="booking"
      data-booking
      data-services={JSON.stringify(Object.fromEntries(serviceOptions.map((o) => [o.id, o.name])))}
      novalidate
    >
      <div class="field">
        <label for="b-name">Όνομα</label>
        <input id="b-name" name="name" type="text" autocomplete="name" required />
      </div>
      <div class="field">
        <label for="b-phone">Τηλέφωνο</label>
        <input id="b-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required />
      </div>
      <div class="field">
        <label for="b-area">Περιοχή</label>
        <input id="b-area" name="area" type="text" list="b-areas" autocomplete="address-level3" required />
        <datalist id="b-areas">
          {allAreas.map((a) => <option value={a} />)}
        </datalist>
      </div>
      <div class="field">
        <label for="b-service">Υπηρεσία</label>
        <select id="b-service" name="service">
          {serviceOptions.map((o) => <option value={o.name}>{o.name}</option>)}
          <option value="Δεν είμαι σίγουρος/η">Δεν είμαι σίγουρος/η</option>
        </select>
      </div>
      <div class="field field--wide">
        <label for="b-day">Ποια μέρα σας εξυπηρετεί;</label>
        <input id="b-day" name="day" type="text" placeholder="π.χ. Τρίτη πρωί" />
      </div>
      <div class="field field--wide">
        <label for="b-msg">Σχόλια <span class="field__opt">(προαιρετικά)</span></label>
        <textarea id="b-msg" name="message" rows="4" placeholder="Τετραγωνικά, μπάνια, κατοικίδια κ.λπ."></textarea>
      </div>

      <div class="booking__foot field--wide">
        <p class="booking__send-label">Αποστολή μέσω:</p>
        <div class="booking__send">
          {
            site.contact.whatsapp && (
              <button class="btn" type="submit" data-via="whatsapp">
                <Icon name="whatsapp" /> WhatsApp
              </button>
            )
          }
          {
            site.contact.viber && (
              <button class="btn btn--green" type="submit" data-via="viber">
                <Icon name="viber" /> Viber
              </button>
            )
          }
          {
            hasEmail && (
              <button class="btn btn--ghost" type="submit" data-via="email">
                <Icon name="mail" /> Email
              </button>
            )
          }
        </div>
        <p class="small muted">
          Η φόρμα δεν αποθηκεύει τα στοιχεία σας. Ανοίγει έτοιμο μήνυμα στην εφαρμογή που επιλέγετε.
          <a href="/politiki-aporritou/">Πολιτική απορρήτου</a>
        </p>
      </div>
      <p class="booking__status field--wide" data-status role="status" hidden></p>
    </form>
  </div>
</section>

<script>
  import { links } from '../../lib/site';

  const form = document.querySelector<HTMLFormElement>('[data-booking]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const show = (text: string) => {
      status.textContent = text;
      status.hidden = false;
    };

    const compose = () => {
      const f = new FormData(form);
      const v = (k: string) => String(f.get(k) ?? '').trim();
      return [
        'Γεια σας! Θα ήθελα ραντεβού για καθαρισμό.',
        `- Όνομα: ${v('name')}`,
        `- Τηλέφωνο: ${v('phone')}`,
        `- Περιοχή: ${v('area')}`,
        `- Υπηρεσία: ${v('service')}`,
        v('day') && `- Μέρα: ${v('day')}`,
        v('message') && `- Σχόλια: ${v('message')}`,
      ]
        .filter(Boolean)
        .join('\n');
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const via = ((e as SubmitEvent).submitter as HTMLElement | null)?.dataset.via ?? 'whatsapp';
      const text = compose();
      if (via === 'whatsapp') {
        window.open(links.whatsapp(text), '_blank', 'noopener');
        show('Ανοίγει το WhatsApp με το μήνυμά σας. Πατήστε «Αποστολή» εκεί για να το στείλετε.');
      } else if (via === 'viber') {
        // Viber doesn't always prefill text, so copy it too.
        navigator.clipboard?.writeText(text).catch(() => {});
        window.location.href = links.viber(text);
        show('Ανοίγει το Viber. Αν το μήνυμα δεν εμφανιστεί, έχει αντιγραφεί: κάντε επικόλληση και αποστολή.');
      } else {
        window.location.href = links.mail('Ραντεβού για καθαρισμό', text);
        show('Ανοίγει το email σας με το μήνυμα έτοιμο. Πατήστε «Αποστολή» εκεί.');
      }
    });

    // Filled in from the cost estimator ("Στη φόρμα").
    window.addEventListener('estimate:use', (e) => {
      const { service, summary } = (e as CustomEvent).detail ?? {};
      const select = form.querySelector<HTMLSelectElement>('#b-service')!;
      const names: Record<string, string> = JSON.parse(form.dataset.services || '{}');
      if (service && names[service]) select.value = names[service];
      const msg = form.querySelector<HTMLTextAreaElement>('#b-msg')!;
      if (summary) msg.value = summary;
      setTimeout(() => form.querySelector<HTMLInputElement>('#b-name')?.focus({ preventScroll: true }), 400);
    });
  }
</script>

<style>
  .contact {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  .contact__intro {
    display: grid;
    gap: 1.25rem;
  }

  .direct {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }
  .direct__item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    word-break: break-word;
  }
  .direct__item:hover {
    border-color: var(--green);
    color: var(--ink);
  }
  .direct__item :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--green);
    flex: none;
  }
  .direct__label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .contact__hours {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
  .contact__hours :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .booking {
    display: grid;
    gap: 1.1rem;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }
  .field {
    display: grid;
    gap: 0.4rem;
  }
  .field label {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .field__opt {
    font-weight: 400;
    color: var(--ink-soft);
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    font: inherit;
    font-size: 1rem;
    color: var(--ink);
    background: var(--limestone);
    border: 1.5px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    min-height: 3rem;
  }
  .field textarea {
    resize: vertical;
    min-height: 6rem;
  }
  .field select {
    appearance: none;
    background-image:
      linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(135deg, var(--ink) 50%, transparent 50%);
    background-position:
      calc(100% - 1.15rem) 55%,
      calc(100% - 0.8rem) 55%;
    background-size: 0.35rem 0.35rem;
    background-repeat: no-repeat;
    padding-right: 2.5rem;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--green);
    box-shadow: 0 0 0 3px rgb(31 74 64 / 0.18);
  }
  .field input::placeholder,
  .field textarea::placeholder {
    color: #8a8f8b;
  }
  .booking__foot {
    display: grid;
    gap: 0.75rem;
    padding-top: 0.25rem;
  }
  .booking__send-label {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .booking__send {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  @media (max-width: 479px) {
    .booking__send {
      display: grid;
    }
  }
  .booking__status {
    padding: 0.85rem 1rem;
    border-radius: var(--radius-sm);
    font-weight: 500;
    background: var(--green-tint);
    color: var(--green-deep);
  }

  @media (min-width: 640px) {
    .booking {
      grid-template-columns: 1fr 1fr;
    }
    .field--wide {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 900px) {
    .contact {
      grid-template-columns: 5fr 7fr;
      gap: 4rem;
    }
  }
</style>
