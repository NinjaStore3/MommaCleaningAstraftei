---
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';
import { site } from '../../lib/site';

const years = new Date().getFullYear() - site.owner.since;
---

<section class="section" id="gia-mena" aria-labelledby="about-title">
  <div class="wrap about">
    <Photo
      name="owner"
      shape="arch"
      alt={`Η ${site.owner.firstName}`}
      sizes="(min-width: 900px) 30vw, 80vw"
      class="about__photo"
    >
      <div slot="fallback" class="photo-panel photo-panel--light about__panel">
        <p class="about__years">{years}</p>
        <p class="about__years-label">χρόνια εμπειρίας</p>
        <p class="about__years-since">από το {site.owner.since}</p>
      </div>
    </Photo>
    <div class="about__text">
      <p class="eyebrow">Ποια είμαι</p>
      <h2 id="about-title">Καθαρίζω σπίτια από το {site.owner.since}.</h2>
      <div class="about__body">
        <p>
          Είμαι η {site.owner.firstName}. Σε {years} χρόνια δουλειάς έχω μάθει ότι η διαφορά φαίνεται στις λεπτομέρειες:
          στις γωνίες, στους αρμούς των πλακακιών, στα σημεία που δεν κοιτάζει κανείς.
        </p>
        <p>
          Δουλεύω μόνη μου και αναλαμβάνω έως δύο σπίτια τη μέρα, ώστε κάθε σπίτι να έχει τον χρόνο που χρειάζεται. Στο
          σπίτι σας έρχομαι πάντα εγώ, όχι κάθε φορά άλλο συνεργείο.
        </p>
        <p>
          Συμφωνούμε από πριν τι θα γίνει και πόσο κοστίζει. Αν κάτι δεν είναι όπως το θέλετε, μου το λέτε και το
          διορθώνω.
        </p>
      </div>
      <p class="about__sign">{site.owner.firstName}</p>
      <ul class="about__facts" role="list">
        <li><Icon name="pin" /><span>Μένω {site.areas.base} και καλύπτω όλη την Αθήνα</span></li>
        <li><Icon name="clock" /><span>{site.contact.hours}</span></li>
        <li><Icon name="receipt" /><span>Απόδειξη σε κάθε επίσκεψη</span></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }
  .about :global(.about__photo) {
    aspect-ratio: 4 / 5;
    max-width: 22rem;
    width: 100%;
    margin: 0;
    justify-self: center;
  }
  .about__panel {
    gap: 0.25rem;
  }
  .about__years {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(5rem, 4rem + 4vw, 7.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
  }
  .about__years-label {
    font-family: var(--serif);
    font-size: 1.375rem;
  }
  .about__years-since {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terracotta);
  }
  .about__text {
    display: grid;
    gap: 1.25rem;
    max-width: 36rem;
  }
  .about__body {
    display: grid;
    gap: 1rem;
    font-size: var(--text-lg);
  }
  .about__sign {
    font-family: var(--serif);
    font-size: 1.375rem;
    color: var(--green);
  }
  .about__facts {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.6rem;
    color: var(--ink-soft);
    font-size: 0.9375rem;
  }
  .about__facts li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.7rem;
    align-items: start;
  }
  .about__facts :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--green);
    margin-top: 0.1rem;
  }

  @media (min-width: 900px) {
    .about {
      grid-template-columns: 5fr 7fr;
      gap: 5rem;
    }
  }
</style>
