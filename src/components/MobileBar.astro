---
import Icon from './ui/Icon.astro';
import { site, links } from '../lib/site';
---

<nav class="mobile-bar" aria-label="Γρήγορη επικοινωνία">
  <a href={links.tel}><Icon name="phone" /><span>Κλήση</span></a>
  {site.contact.viber && <a href={links.viber()}><Icon name="viber" /><span>Viber</span></a>}
  {
    site.contact.whatsapp && (
      <a href={links.whatsapp()} target="_blank" rel="noopener">
        <Icon name="whatsapp" />
        <span>WhatsApp</span>
      </a>
    )
  }
</nav>

<style>
  .mobile-bar {
    position: fixed;
    inset: auto 0 0 0;
    z-index: 40;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    height: calc(var(--bar-h) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--green-deep);
    border-top: 1px solid rgb(0 0 0 / 0.2);
  }
  .mobile-bar a {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.2rem;
    color: var(--limestone);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .mobile-bar a + a {
    border-left: 1px solid rgb(247 244 238 / 0.15);
  }
  .mobile-bar a:active {
    background: var(--green);
  }
  .mobile-bar :global(svg) {
    width: 1.4rem;
    height: 1.4rem;
  }
  .mobile-bar :focus-visible {
    outline-color: var(--gold);
    outline-offset: -4px;
  }
  @media (min-width: 900px) {
    .mobile-bar {
      display: none;
    }
  }
</style>
