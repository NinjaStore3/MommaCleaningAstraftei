---
/**
 * A photo slot. Drop a file named `<name>.jpg` (or .jpeg/.png/.webp) into src/assets/photos/
 * and it appears here, converted to AVIF/WebP at the right sizes.
 * Until then, a tinted placeholder with a caption shows what the photo should be.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';

interface Props {
  name: string;
  alt: string;
  /** What the photo should show (placeholder caption). */
  caption: string;
  shape?: 'arch' | 'rect';
  sizes?: string;
  class?: string;
  loading?: 'eager' | 'lazy';
}

const { name, alt, caption, shape = 'rect', sizes = '(min-width: 900px) 40vw, 100vw', class: className, loading = 'lazy' } =
  Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/photos/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG}', {
  eager: true,
});
const match = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === name);
const img = match?.[1].default;
---

<figure class:list={['photo', shape === 'arch' && 'photo--arch', className]}>
  {
    img ? (
      <Picture
        src={img}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200].filter((w) => w <= img.width)}
        sizes={sizes}
        loading={loading}
        fetchpriority={loading === 'eager' ? 'high' : undefined}
      />
    ) : (
      <div class="photo-placeholder" role="img" aria-label={`Θέση για φωτογραφία: ${caption}`}>
        <span>
          <Icon name="camera" />
          φωτογραφία: {caption}
        </span>
      </div>
    )
  }
</figure>
