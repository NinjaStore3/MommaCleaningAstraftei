---
import '../styles/global.css';
import { site, filled } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Path of this page, e.g. "/oroi/" (for the canonical URL). */
  path?: string;
  noindex?: boolean;
  /** Structured data objects, rendered as JSON-LD. */
  jsonld?: object[];
}

const { title, description, path = '/', noindex = false, jsonld = [] } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;
const cfToken = site.analytics.cloudflareToken;
---

<!doctype html>
<html lang="el">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="preload" href="/fonts/literata-greek.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/commissioner-greek.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#f7f4ee" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="el_GR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Αστράφτει — καθαρισμός σπιτιού στην Αθήνα" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}

    {
      filled(cfToken) && (
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: cfToken })}
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
